{
  "name": "sheet-alerts-bot",
  "version": "1.0.0",
  "description": "Google Workspace Add-on for Slack/Gmail Alerts",
  "scripts": {
    "push": "clasp push",
    "deploy": "./deploy.sh",
    "open": "clasp open",
    "status": "clasp deployments",
    "logs": "clasp logs --tail",
    "sb:deploy": "supabase functions deploy bot --no-verify-jwt",
    "sb:set-url": "supabase secrets set GAS_WEBAPP_URL=$npm_config_url"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.11"
  }
}
